---
import { getCollection, render } from 'astro:content';
import Seo from '@components/Seo/Seo.astro';
import type { BlogPost } from 'src/types/collections.ts';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => {
		return data.lang === 'es' && !data.draft;
	});

	return posts.map((post) => ({
		params: {
			slug: post.data.slug ?? post.id.replace(/^es\//, ''),
		},
		props: { post },
	}));
}

const { post } = Astro.props as { post: BlogPost };
const slug = post.data.slug ?? post.id.replace(/^es\//, '');
const { Content } = await render(post);
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<Seo
			lang="es"
			title={`${post.data.title} | porfi.dev`}
			description={post.data.description}
			path={`/es/blog/${slug}`}
			type="article"
		/>
	</head>
	<body>
		<main>
			<a href="/es/blog">Volver al blog</a>

			<article>
				<header>
					<time datetime={post.data.pubDate.toISOString()}>
						{
							post.data.pubDate.toLocaleDateString('es-MX', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})
						}
					</time>
					<h1>{post.data.title}</h1>
					<p>{post.data.description}</p>
				</header>

				<Content />
			</article>
		</main>
	</body>
</html>
