---
import 'normalize.css';
import '@styles/index.css';
import ContactSection from '@components/ContactSection/ContactSection.astro';
import HomePageLogo from '@components/HomePageLogo/HomePageLogo.astro';
import HomePageNav from '@components/HomePageNav/HomePageNav.astro';
import Seo from '@components/Seo/Seo.astro';
import Footer from '@components/Footer/Footer.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MyWebSite" />
		<link rel="manifest" href="/site.webmanifest" />

		<Seo
			lang="es"
			title="<porfi.dev /> | Software engineer"
			description="Portafolio de Porfirio Chávez, desarrollador web especializado en interfaces, aplicaciones modernas y experiencias digitales."
			path="/es"
		/>
	</head>
	<body>
		<header class="home-page-header">
			<HomePageLogo />
			<HomePageNav lang="es" />
			<!--FloatMenu-->
		</header>

		<section id="welcome">
			<header>
				<h1>Porfirio Chávez</h1>
				<h2>Desarrollo de software</h2>
				<p>Desde 2013 desarrollo aplicaciones web. Trabajo en todo el proceso, desde la interfaz que usan las personas hasta las APIs y los servicios que la hacen funcionar.</p>
				<a class="welcome__contact-link" href="#contact">Hablemos</a>
			</header>
			<img class="welcome__image" src="/images/hero-laptop.webp" width="1000" height="640" alt="" />
			<canvas id="canvas-particles"></canvas>
		</section>
		<main>
			<ContactSection lang="es" />
		</main>
		<Footer lang="es" />
		<script>
			import '@scripts/background-particle.ts';
		</script>
	</body>
</html>
