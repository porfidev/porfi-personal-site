---
import 'normalize.css';
import '@styles/index.css';
import ContactSection from '@components/ContactSection/ContactSection.astro';
import Seo from '@components/Seo/Seo.astro';
import Footer from '@components/Footer/Footer.astro';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MyWebSite" />
		<link rel="manifest" href="/site.webmanifest" />

		<Seo
			lang="es"
			title="porfi.dev | Desarrollador Full Stack"
			description="Portafolio de Porfirio Chávez, desarrollador web especializado en interfaces, aplicaciones modernas y experiencias digitales."
			path="/es"
		/>
	</head>
	<body>
		<!--
		<header>
			<MainMenu />
			<FloatMenu />
		</header>
		<section id="welcome">
			<header>
				<h1>Porfirio Chávez</h1>
			</header>
			<canvas id="canvas-particles"></canvas>
		</section>
		<div style="width: 100%; height: 3000px; background-color: brown"></div>-->
		<main>
			<ContactSection lang="es" />
		</main>
		<Footer lang="es" />
		<script>
			import '@scripts/background-particle.ts';
		</script>
	</body>
</html>
