---
import 'normalize.css';
import '@styles/index.css';
import './index.styles.css';

const targetPath = '/es';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta http-equiv="refresh" content={`1.2;url=${targetPath}`} />
		<link rel="alternate" hreflang="es" href="/es" />
		<link rel="alternate" hreflang="en" href="/en" />
		<link rel="alternate" hreflang="x-default" href="/es" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="MyWebSite" />
		<link rel="manifest" href="/site.webmanifest" />

		<title>💻 porfi.dev | software engineer ⚛️</title>
	</head>
	<body class="redirect-page">
		<main>
			<div class="loader" aria-label="cargando"></div>
		</main>
		<script is:inline>
			const supportedLocales = ['es', 'en'];
			const fallbackLocale = 'es';

			const preferredLocale =
				navigator.languages
					?.map((locale) => locale.toLowerCase().split('-')[0])
					.find((locale) => supportedLocales.includes(locale)) ||
				navigator.language?.toLowerCase().split('-')[0];

			const targetLocale = supportedLocales.includes(preferredLocale)
				? preferredLocale
				: fallbackLocale;

			window.setTimeout(() => {
				window.location.replace(`/${targetLocale}`);
			}, 1200);
		</script>
	</body>
</html>
