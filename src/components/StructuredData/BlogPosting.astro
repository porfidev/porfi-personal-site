---
import { getRequiredEnv } from '@scripts/env.ts';
import type { BlogPost } from 'src/types/collections.ts';

type Props = {
	post: BlogPost;
	slug: string;
};

const { post, slug } = Astro.props;
const siteUrl = getRequiredEnv('PUBLIC_SITE_URL');

const canonicalUrl = new URL(`/es/blog/${slug}`, siteUrl).toString();
const imageUrl = post.data.cover ? new URL(post.data.cover, siteUrl).toString() : undefined;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': post.data.schemaType,
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.pubDate.toISOString(),
	dateModified: post.data.updatedDate?.toISOString() ?? post.data.pubDate.toISOString(),
	author: {
		'@type': 'Person',
		name: post.data.author,
		alternateName: post.data.authorAlias,
		url: siteUrl,
		sameAs: post.data.authorSameAs,
	},
	publisher: {
		'@type': 'Person',
		name: 'Porfirio Chavez',
		url: siteUrl,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl,
	},
	inLanguage: post.data.lang,
	keywords: post.data.tags,
	url: canonicalUrl,
	articleSection: post.data.tags[0],
	about: post.data.tags.map((tag) => ({
		'@type': 'Thing',
		name: tag,
	})),
	isPartOf: {
		'@type': 'Blog',
		name: 'porfi.dev Blog',
		url: new URL('/es/blog', siteUrl).toString(),
	},
	...(imageUrl
		? {
				image: {
					'@type': 'ImageObject',
					url: imageUrl,
					caption: post.data.coverAlt,
				},
				thumbnailUrl: imageUrl,
			}
		: {}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
