---
import './ContactSection.styles.css';
import ContactForm from '../ContactForm/ContactForm.astro';
import { contactCopy, type ContactLang } from '@i18n/contact.ts';
import GlassCard from '@components/ui/GlassCard/GlassCard.astro';
import StatusIndicator from '@components/ui/StatusIndicator/StatusIndicator.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import LinkedinIcon from '@components/icons/LinkedinIcon.astro';

interface Props {
	lang: ContactLang;
}

const { lang } = Astro.props;
const copy = contactCopy[lang];
---

<section id="contact" class="contact">
	<div class="contact__header">
		<div>
			<h1 class="contact__title">{copy.title}</h1>
			<p class="contact__text">
				<strong>{copy.leadTitle}</strong><br />
				{copy.leadBody}
			</p>
			<p class="contact__text">{copy.note}</p>
		</div>
	</div>
	<div class="contact__content">
		<ContactForm copy={copy.form} />

		<div class="contact__card-grid">
			<GlassCard
				class="contact__card contact__card--featured contact__card--status contact__card--wide"
			>
				<StatusIndicator>{copy.currentStatus}</StatusIndicator>
				<h2 class="contact__card-title">
					{copy.openCardTitle.map((line) => <span>{line}</span>)}
				</h2>
			</GlassCard>
			<GlassCard class="contact__card contact__card--github contact__card--link">
				<a
					class="contact__card-link"
					href="https://github.com/porfidev"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Porfi Github"
				>
					<GithubIcon class="contact__card-icon" />
					<span class="contact__card-icon-text">github</span>
				</a>
			</GlassCard>
			<GlassCard class="contact__card contact__card--linkedin contact__card--link">
				<a
					class="contact__card-link"
					href="https://linkedin.com/in/porfidev"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Porfi Linkedin"
				>
					<LinkedinIcon class="contact__card-icon" />
					<span class="contact__card-icon-text">linkedin</span>
				</a>
			</GlassCard>
			<GlassCard class="contact__card contact__card--wide" />
		</div>
	</div>
</section>
