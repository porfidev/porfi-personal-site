---
import './ContactSection.styles.css';
import ContactForm from '../ContactForm/ContactForm.astro';
import { contactCopy, type ContactLang } from '@i18n/contact.ts';
import GlassCard from '@components/ui/GlassCard/GlassCard.astro';
import PulseDot from '@components/ui/PulseDot/PulseDot.astro';
import StatusIndicator from '@components/ui/StatusIndicator/StatusIndicator.astro';

interface Props {
	lang: ContactLang;
}

const { lang } = Astro.props;
const copy = contactCopy[lang];
---

<section id="contact" class="contact">
	<div class="contact__header">
		<div>
			<h1 class="contact__h1">{copy.title}</h1>
			<p class="contact__p">
				<strong>{copy.leadTitle}</strong><br />
				{copy.leadBody}
			</p>
			<p class="contact__p">{copy.note}</p>
		</div>
	</div>
	<div class="contact__container">
		<ContactForm copy={copy.form} />

		<div class="contact__cards">
			<GlassCard
				class="contact__card contact__card--active contact__card--status contact__card--wide"
			>
				<StatusIndicator>{copy.currentStatus}</StatusIndicator>
				<h2 class="contact__card-title">
					{copy.openCardTitle.map((line) => <span>{line}</span>)}
				</h2>
			</GlassCard>
			<GlassCard class="contact__card" />
			<GlassCard class="contact__card" />
			<GlassCard class="contact__card contact__card--wide" />
		</div>
	</div>
</section>
